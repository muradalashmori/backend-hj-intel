# HJ Motors Price Intelligence — Environment Variables
# Copy this file to .env and fill in values

# Anthropic API Key (optional — can also be passed per-request from the UI)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Cache duration in seconds (default: 1 hour)
CACHE_TTL=3600

# Scraper timeout per source in seconds
SCRAPE_TIMEOUT=12

# Log level: debug | info | warning | error
LOG_LEVEL=info

# Redis URL (auto-configured in docker-compose, change only if using external Redis)
REDIS_URL=redis://redis:6379/0
